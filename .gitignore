.vercel
node_modules/
.next/

# Tauri — never commit Rust build output (was causing multi‑GB pushes)
src-tauri/target/

# Tauri desktop bundle (generated by npm run build:desktop)
src-tauri/next-server/**
!src-tauri/next-server/.gitkeep
src-tauri/nodejs/

# Environment variables — never commit real keys
.env
.env.local
.env.*.local

# Firebase Admin SDK service account — contains private key
*-firebase-adminsdk-*.json

# OS / editor
.DS_Store
*.pem

# Python bytecode / caches
__pycache__/
*.py[cod]

# TypeScript incremental build cache
*.tsbuildinfo
