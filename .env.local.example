# Environment variables for AI-EcoTrack
# Copy this file to .env.local and fill in values

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional — Google OAuth Web Client ID for smoother Google sign-in in the Tauri app (Google Identity Services).
# Without it, the desktop app uses Firebase redirect sign-in with your existing NEXT_PUBLIC_FIREBASE_* config only.
# Google Cloud → Credentials → OAuth 2.0 Web client (same as Firebase → Authentication → Google → Web client ID).
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Firebase Admin (for server-side API routes — pi-scan, generate-dpp)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Raspberry Pi IoT Integration
# A secret shared between your Pi and this server.
# Generate a secure value: openssl rand -hex 32
PI_DEVICE_TOKEN=your-secret-pi-device-token-here

# Google Cloud Text-to-Speech (for disassembly guide audio)
# Enable at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Then create an API key at: https://console.cloud.google.com/apis/credentials
# Free tier: 4M chars/month (Standard) · 1M chars/month (WaveNet)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
